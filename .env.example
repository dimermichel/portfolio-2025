# EmailJS — used by the Contact form to send emails without a backend.
# Sign up at https://www.emailjs.com and create a service + email template.

# Found in EmailJS dashboard → Email Services → your service → Service ID
VITE_EMAILJS_SERVICE_ID=your_service_id

# Found in EmailJS dashboard → Email Templates → your template → Template ID
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Found in EmailJS dashboard → Account → API Keys → Public Key
VITE_EMAILJS_PUBLIC_KEY=your_public_key
